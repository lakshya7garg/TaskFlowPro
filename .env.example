# TaskFlow Pro - Environment Configuration

# Server Port
PORT=5000

# PostgreSQL Database Connection URL
# e.g., postgres://postgres:password@localhost:5432/taskflowpro
# (If omitted, TaskFlow Pro automatically runs in zero-config memory mode for local testing)
DATABASE_URL=postgres://postgres:password@localhost:5432/taskflowpro

# Google Gemini API Key for AI-Augmented Dependency Suggestions
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
